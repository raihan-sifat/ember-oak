# Used only in production — points the server at a hosted Turso database so
# bookings survive restarts/redeploys.
# Leave both unset for local dev: db.js falls back to a local bookings.db file.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Origin of the deployed client, used to lock down CORS. Leave unset locally.
CLIENT_ORIGIN=https://your-app.vercel.app
